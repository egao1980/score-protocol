;;;; SC0: constructors, accessors, normalisation, the canonical form, equality.
;;;; Expected values follow the file headers of src/elements.lisp,
;;;; src/measure-map.lisp, src/score.lisp and src/sexp.lisp. The fixture scores
;;;; are hand-built in canonical form (tests/fixtures/PROVENANCE.md). Every
;;;; expected value was checked against a separate reference implementation of
;;;; those rules.

(in-package #:score-protocol/tests)

(defun p (s) (parse-pitch s))
(defun pc (s) (parse-pitch-class s))

(defun nth-part (score i) (fset:@ (score-parts score) i))
(defun nth-measure (score i) (fset:@ (score-measure-map score) i))

(defun voice-events (voice i)
  "The events of voice measure I of VOICE, as a list."
  (seq-list (fset:@ (voice-measures voice) i)))

;;; Canonical form: fixtures ----------------------------------------------

(deftest-parametrize fixture-round-trip
    ((name) :rows +fixture-scores+)
  (let* ((form (fixture-form name))
         (score (sexp-to-score form)))
    (ok (typep score 'score))
    (ok (equal form (score-to-sexp score)) "a canonical fixture prints back unchanged")
    (ok (score-equal score (sexp-to-score (score-to-sexp score))))
    (ok (= (score-id-counter score) (getf (rest form) :id-counter)))))

;;; Accessors ---------------------------------------------------------------

(deftest keyboard-accessors
  (let* ((s (fixture-score "sc0-keyboard"))
         (flute (nth-part s 0))
         (piano (nth-part s 1))
         (flute-voice (first (part-voices flute)))
         (upper (first (part-voices piano)))
         (lower (second (part-voices piano)))
         (bass (third (part-voices piano))))
    (ok (typep (score-parts s) 'fset:seq))
    (ok (typep (score-measure-map s) 'fset:seq))
    (ok (typep (score-chord-symbols s) 'fset:seq))
    (ok (typep (score-spanners s) 'fset:seq))
    (ok (typep (voice-measures upper) 'fset:seq))
    (ok (typep (fset:@ (voice-measures upper) 0) 'fset:seq))
    (ok (equal '(:title "Keyboard and Flute" :arranger "Test Arranger") (score-metadata s)))
    (ok (= 49 (score-id-counter s)))
    (ok (= 2 (fset:size (score-parts s))))
    (ok (equal '("Flute" "Fl." "Piano" "Pno.")
               (list (part-name flute) (part-abbreviation flute)
                     (part-name piano) (part-abbreviation piano))))
    (ok (listp (part-staves piano)))
    (ok (equal '(:treble :bass) (mapcar #'staff-clef (part-staves piano))))
    (ok (equal '(1 1 2) (mapcar #'voice-staff (part-voices piano))))
    (ok (equal '(:up :down nil) (mapcar #'voice-stem (part-voices piano))))
    (ok (= 3 (fset:size (voice-measures lower))))
    (ok (null (voice-events lower 0)) "a silent voice measure is empty")
    (let ((r (first (voice-events flute-voice 0))))
      (ok (typep r 'rest-event))
      (ok (eq t (rest-event-measure-rest-p r)))
      (ok (null (rest-event-hidden-p r)))
      (ok (eql 1 (event-duration r))))
    (destructuring-bind (grace main f g a b rest) (voice-events flute-voice 1)
      (declare (ignore g rest))
      (ok (typep grace 'note-event))
      (ok (typep grace 'sounding-event))
      (ok (eq :acciaccatura (event-grace grace)))
      (ok (eql 1/8 (event-duration grace)))
      (ok (equal '(:tenuto) (event-articulations main)))
      (ok (eq :p (event-dynamic main)))
      (ok (and (eql 1/12 (event-duration f)) (eql 3/2 (event-tuplet f))))
      (ok (equal "e-c" (element-id a)))
      (ok (equal '(:accent :staccato) (event-articulations b)))
      (ok (eq t (event-breath-mark b))))
    (ok (eq :forced (note-accidental (first (voice-events flute-voice 2)))))
    (ok (eq :normal (event-fermata (second (voice-events flute-voice 2)))))
    (destructuring-bind (c1 c2) (voice-events upper 0)
      (ok (typep c1 'chord-event))
      (ok (eq :mf (event-dynamic c1)))
      (ok (= 3 (length (chord-event-notes c1))))
      (ok (every (lambda (n) (typep n 'chord-note)) (chord-event-notes c1)))
      (ok (equalp (p "C4") (note-pitch (first (chord-event-notes c1)))))
      (ok (eq :auto (note-accidental (first (chord-event-notes c1)))))
      (ok (equal "n-w" (note-tie (third (chord-event-notes c2))))))
    (ok (eq :cautionary (note-accidental (second (chord-event-notes (first (voice-events upper 1)))))))
    (ok (eq t (rest-event-hidden-p (first (voice-events lower 1)))))
    (ok (equal "e-1a" (note-tie (first (voice-events bass 1)))))
    (let ((m (nth-measure s 0)))
      (ok (typep m 'measure-info))
      (ok (equalp (parse-meter "4/4") (measure-info-time m)))
      (ok (equalp (parse-key "C major") (measure-info-key m)))
      (ok (= 1 (length (measure-info-tempo m))))
      (let ((mark (first (measure-info-tempo m))))
        (ok (tempo-mark-p mark))
        (ok (eql 0 (tempo-mark-offset mark)))
        (ok (equalp (make-tempo :bpm 108 :beat-unit 1/4) (tempo-mark-tempo mark)))
        (ok (equal "Allegretto" (tempo-mark-text mark)))))
    (ok (null (measure-info-time (nth-measure s 1))))
    (ok (eq :final (measure-info-barline (nth-measure s 2))))
    (ok (equal '(:slur :slur) (mapcar #'spanner-kind (seq-list (score-spanners s)))))
    (ok (equal '(("e-8" "e-9") ("e-9" "e-c"))
               (mapcar (lambda (sp) (list (spanner-start sp) (spanner-end sp)))
                       (seq-list (score-spanners s)))))))

(deftest measure-map-accessors
  (let ((changes (fixture-score "sc0-key-change"))
        (repeats (fixture-score "sc0-repeats-voltas"))
        (jumps (fixture-score "sc0-jumps"))
        (pickup (fixture-score "sc0-pickup")))
    (ok (equal '("1" "2" "3" "4" "5" "6")
               (mapcar #'measure-info-number (seq-list (score-measure-map changes)))))
    (ok (equalp (list (parse-key "C major") nil (parse-key "D major") nil (parse-key "Bb major") nil)
                (mapcar #'measure-info-key (seq-list (score-measure-map changes)))))
    (ok (equal "B" (measure-info-rehearsal (nth-measure changes 2))))
    (let ((marks (measure-info-tempo (nth-measure changes 3))))
      (ok (equal '(0 1/2) (mapcar #'tempo-mark-offset marks)))
      (ok (equal '("poco rit." nil) (mapcar #'tempo-mark-text marks)))
      (ok (equalp (list nil (make-tempo :bpm 80 :beat-unit 1/4)) (mapcar #'tempo-mark-tempo marks))))
    (ok (equal '(t nil nil nil t nil nil)
               (mapcar #'measure-info-repeat-start (seq-list (score-measure-map repeats)))))
    (ok (equal '(nil nil 2 nil nil 3 nil)
               (mapcar #'measure-info-repeat-end (seq-list (score-measure-map repeats)))))
    (ok (equal '(() () (1) (2) () (1 2) (3))
               (mapcar #'measure-info-volta (seq-list (score-measure-map repeats)))))
    (ok (equal '(:regular :regular :regular :double :regular :regular :final)
               (mapcar #'measure-info-barline (seq-list (score-measure-map repeats)))))
    (ok (equal '(() (:segno) () (:to-coda) (:dal-segno-al-coda) (:coda) ())
               (mapcar #'measure-info-jump (seq-list (score-measure-map jumps)))))
    (ok (equal '(t nil nil nil nil)
               (mapcar #'measure-info-pickup-p (seq-list (score-measure-map pickup)))))
    (ok (equal '(1/4 nil nil nil 1/2)
               (mapcar #'measure-info-length (seq-list (score-measure-map pickup)))))))

(deftest lyric-and-chord-symbol-accessors
  (let* ((verses (fixture-score "sc0-three-verses"))
         (voice (first (part-voices (nth-part verses 0))))
         (bar3 (voice-events voice 2))
         (chords (fixture-score "sc0-chords-under-rests"))
         (anchors (seq-list (score-chord-symbols chords))))
    (let ((lyrics (event-lyrics (second bar3))))
      (ok (equal '(1 2 3) (mapcar #'lyric-verse lyrics)))
      (ok (equal '("dwell," "y" "tell,") (mapcar #'lyric-text lyrics)))
      (ok (equal '(:single :end :single) (mapcar #'lyric-syllabic lyrics)))
      (ok (equal '(t nil t) (mapcar #'lyric-extender lyrics))))
    (ok (equal '(2) (mapcar #'lyric-verse (event-lyrics (third bar3)))))
    (ok (eq t (event-breath-mark (third bar3))))
    (ok (equal '((1 . 0) (1 . 1/4) (2 . 0) (2 . 1/2) (3 . 0) (3 . 1/2) (4 . 0) (4 . 3/4))
               (mapcar #'anchor-position anchors)))
    (ok (equalp (make-chord-symbol :root (pc "C") :quality :dominant-7 :text "C7" :dialect :pop)
                (anchor-symbol (second anchors))))
    (ok (equalp (make-chord-symbol :root (pc "C") :quality :dominant-7 :alterations '((9 . -1)))
                (anchor-symbol (fifth anchors))))
    (ok (equalp (make-chord-symbol :root (pc "F") :quality :major :bass (pc "A"))
                (anchor-symbol (sixth anchors))))
    (ok (chord-symbol-no-chord-p (anchor-symbol (eighth anchors))))))

(deftest provenance-accessors
  (let* ((s (fixture-score "sc0-omr-result"))
         (part (nth-part s 0))
         (voice (first (part-voices part)))
         (first-note (first (voice-events voice 0)))
         (last-note (first (voice-events voice 2)))
         (chord (first (voice-events voice 1)))
         (prov (element-provenance first-note)))
    (ok (provenance-p prov))
    (ok (eq :omr (provenance-source prov)))
    (ok (equal "omr-example" (provenance-backend prov)))
    (ok (eql 1 (provenance-page prov)))
    (ok (equal '(60 140 20 40) (provenance-bbox prov)))
    (ok (null (provenance-time-range prov)))
    (ok (eql 0.95 (element-confidence first-note)))
    (ok (eq :transcription (provenance-source (element-provenance last-note))))
    (ok (equal '(4.5 6.75) (provenance-time-range (element-provenance last-note))))
    (ok (null (element-confidence last-note)))
    (ok (equal '(nil 1/2 1) (mapcar #'element-confidence (chord-event-notes chord))))
    (ok (eql 0 (element-confidence (second (voice-events voice 1)))))
    (ok (eql 0.97 (element-confidence part)))
    (ok (null (element-provenance (first (part-staves part)))))
    (ok (eql 0.3 (element-confidence (fset:@ (score-spanners s) 0))))))

;;; Constructors --------------------------------------------------------------

(deftest constructor-defaults
  (let ((n (make-note-event :pitch (p "C4") :duration 1/4))
        (l (make-lyric :text "la"))
        (m (make-measure-info)))
    (ok (typep n 'note-event))
    (ok (null (element-id n)))
    (ok (null (element-provenance n)))
    (ok (null (element-confidence n)))
    (ok (eq :auto (note-accidental n)))
    (ok (null (note-tie n)))
    (ok (null (event-grace n)))
    (ok (null (event-tuplet n)))
    (ok (null (event-lyrics n)))
    (ok (null (event-articulations n)))
    (ok (= 1 (lyric-verse l)))
    (ok (eq :single (lyric-syllabic l)))
    (ok (null (lyric-extender l)))
    (ok (eq :treble (staff-clef (make-staff))))
    (ok (= 1 (voice-staff (make-voice :measures '()))))
    (ok (null (voice-stem (make-voice :measures '()))))
    (ok (eq :regular (measure-info-barline m)))
    (ok (equal '(nil nil nil nil nil nil nil () () nil ())
               (list (measure-info-number m) (measure-info-time m) (measure-info-key m)
                     (measure-info-pickup-p m) (measure-info-length m)
                     (measure-info-repeat-start m) (measure-info-repeat-end m)
                     (measure-info-volta m) (measure-info-jump m)
                     (measure-info-rehearsal m) (measure-info-tempo m))))
    (ok (null (rest-event-measure-rest-p (make-rest-event :duration 1))))))

(deftest constructor-normalisation
  (ok (equal '(:accent :staccato :tenuto)
             (event-articulations
              (make-note-event :pitch (p "C4") :duration 1/4
                               :articulations '(:tenuto :staccato :accent :staccato)))))
  (ok (equal '(1 2 2 3)
             (mapcar #'lyric-verse
                     (event-lyrics
                      (make-note-event :pitch (p "C4") :duration 1/4
                                       :lyrics (list (make-lyric :verse 3 :text "c")
                                                     (make-lyric :verse 2 :text "b1")
                                                     (make-lyric :text "a")
                                                     (make-lyric :verse 2 :text "b2")))))))
  (ok (equal '("a" "b1" "b2" "c")
             (mapcar #'lyric-text
                     (event-lyrics
                      (make-rest-event :duration 1
                                       :lyrics (list (make-lyric :verse 3 :text "c")
                                                     (make-lyric :verse 2 :text "b1")
                                                     (make-lyric :text "a")
                                                     (make-lyric :verse 2 :text "b2")))))))
  (let ((m (make-measure-info :volta '(3 1 3) :jump '(:fine :segno :fine)
                              :pickup-p "yes" :repeat-start 1
                              :tempo (list (make-tempo-mark :offset 1/2 :text "b")
                                           (make-tempo-mark :text "a1")
                                           (make-tempo-mark :offset 0 :text "a2")))))
    (ok (equal '(1 3) (measure-info-volta m)))
    (ok (equal '(:segno :fine) (measure-info-jump m)))
    (ok (eq t (measure-info-pickup-p m)))
    (ok (eq t (measure-info-repeat-start m)))
    (ok (equal '("a1" "a2" "b") (mapcar #'tempo-mark-text (measure-info-tempo m)))))
  (ok (eq t (event-breath-mark (make-note-event :pitch (p "C4") :duration 1/4 :breath-mark :yes))))
  (ok (eq t (lyric-extender (make-lyric :text "a" :extender 'yes))))
  (ok (eq t (rest-event-hidden-p (make-rest-event :duration 1 :hidden-p 2))))
  (let ((v (make-voice :measures (list (list (make-rest-event :duration 1)) '()))))
    (ok (typep (voice-measures v) 'fset:seq))
    (ok (= 2 (fset:size (voice-measures v))))
    (ok (typep (fset:@ (voice-measures v) 1) 'fset:seq))
    (ok (fset:empty? (fset:@ (voice-measures v) 1))))
  (let ((v (make-voice :measures (fset:seq (fset:seq (make-rest-event :duration 1))))))
    (ok (= 1 (fset:size (voice-measures v))) "seqs are accepted as they are"))
  (let* ((articulations (list :staccato))
         (n (make-note-event :pitch (p "C4") :duration 1/4 :articulations articulations)))
    (setf (first articulations) :tenuto)
    (ok (equal '(:staccato) (event-articulations n)) "constructors store fresh lists")))

(deftest make-score-normalisation
  (let* ((f (make-chord-symbol :root (pc "F") :quality :major))
         (s (make-score
             :metadata '(:composer "Someone" :title "T")
             :measures (fset:seq (make-measure-info :time (parse-meter "4/4") :key (parse-key "F"))
                                 (make-measure-info))
             :parts (list (make-part :staves (list (make-staff))
                                     :voices (list (make-voice :measures '(() ())))))
             :chord-symbols (list (make-chord-symbol-anchor :id "c" :position '(2 . 0) :symbol f)
                                  (make-chord-symbol-anchor :id "b" :position '(1 . 1/2) :symbol f)
                                  (make-chord-symbol-anchor :id "d" :position '(2 . 0) :symbol f)
                                  (make-chord-symbol-anchor :id "a" :position '(1 . 0) :symbol f)))))
    (ok (equal '(:title "T" :composer "Someone") (score-metadata s)))
    (ok (equal '("a" "b" "c" "d") (ids (seq-list (score-chord-symbols s))))
        "the track is stable-sorted by bar, then offset")
    (ok (= 2 (fset:size (score-measure-map s))))
    (ok (= 0 (fset:size (score-spanners s))))
    (ok (= 0 (score-id-counter (make-score))))
    (ok (typep (score-parts (make-score)) 'fset:seq))))

(defun bad-make (function &rest args)
  "A thunk applying FUNCTION to ARGS, for the type-error rows."
  (lambda () (apply function args)))

(deftest-parametrize constructors-signal-type-errors
    ((label thunk)
     ("note pitch as text" (bad-make #'make-note-event :pitch "C4" :duration 1/4))
     ("note without pitch" (bad-make #'make-note-event :duration 1/4))
     ("zero duration" (bad-make #'make-note-event :pitch (p "C4") :duration 0))
     ("float duration" (bad-make #'make-note-event :pitch (p "C4") :duration 0.25))
     ("missing duration" (bad-make #'make-rest-event))
     ("id starting with a digit" (bad-make #'make-note-event :id "1x" :pitch (p "C4") :duration 1/4))
     ("id with a space" (bad-make #'make-rest-event :id "a b" :duration 1))
     ("id not a string" (bad-make #'make-rest-event :id :e1 :duration 1))
     ("non-ASCII id" (bad-make #'make-staff :id "é1"))
     ("unknown grace kind" (bad-make #'make-note-event :pitch (p "C4") :duration 1/8 :grace :slashed))
     ("unknown accidental display" (bad-make #'make-note-event :pitch (p "C4") :duration 1/4 :accidental :sharp))
     ("unknown articulation" (bad-make #'make-note-event :pitch (p "C4") :duration 1/4 :articulations '(:bogus)))
     ("tie to an invalid id" (bad-make #'make-note-event :pitch (p "C4") :duration 1/4 :tie ""))
     ("negative tuplet" (bad-make #'make-note-event :pitch (p "C4") :duration 1/12 :tuplet -3/2))
     ("confidence above 1" (bad-make #'make-rest-event :duration 1 :confidence 1.5))
     ("negative confidence" (bad-make #'make-rest-event :duration 1 :confidence -0.1))
     ("provenance as a plist" (bad-make #'make-rest-event :duration 1 :provenance '(:source :omr)))
     ("unknown dynamic" (bad-make #'make-rest-event :duration 1 :dynamic :loud))
     ("fermata as a boolean" (bad-make #'make-rest-event :duration 1 :fermata t))
     ("lyric as text" (bad-make #'make-rest-event :duration 1 :lyrics '("la")))
     ("verse 0" (bad-make #'make-lyric :verse 0 :text "la"))
     ("lyric without text" (bad-make #'make-lyric))
     ("unknown syllabic" (bad-make #'make-lyric :text "la" :syllabic :start))
     ("chord of note events" (bad-make #'make-chord-event
                                       :notes (list (make-note-event :pitch (p "C4") :duration 1/4))
                                       :duration 1/4))
     ("chord-note without pitch" (bad-make #'make-chord-note))
     ("voice on staff 0" (bad-make #'make-voice :staff 0 :measures '()))
     ("unknown stem" (bad-make #'make-voice :stem :left :measures '()))
     ("voice measure of text" (bad-make #'make-voice :measures '(("C4"))))
     ("part without staves" (bad-make #'make-part :staves '()
                                      :voices (list (make-voice :measures '()))))
     ("part without voices" (bad-make #'make-part :staves (list (make-staff)) :voices '()))
     ("staves in place of voices" (bad-make #'make-part :staves (list (make-staff))
                                            :voices (list (make-staff))))
     ("unknown clef" (bad-make #'make-staff :clef :soprano))
     ("time as text" (bad-make #'make-measure-info :time "4/4"))
     ("key as text" (bad-make #'make-measure-info :key "C major"))
     ("zero length" (bad-make #'make-measure-info :length 0))
     ("unknown barline" (bad-make #'make-measure-info :barline :thick))
     ("repeat played once" (bad-make #'make-measure-info :repeat-end 1))
     ("volta 0" (bad-make #'make-measure-info :volta '(0)))
     ("unknown jump" (bad-make #'make-measure-info :jump '(:dc)))
     ("tempo struct in place of a tempo mark" (bad-make #'make-measure-info
                                                        :tempo (list (make-tempo :bpm 100))))
     ("negative bar" (bad-make #'make-chord-symbol-anchor :position '(-1 . 0)
                               :symbol (make-chord-symbol :no-chord-p t)))
     ("negative offset" (bad-make #'make-chord-symbol-anchor :position '(1 . -1/4)
                                  :symbol (make-chord-symbol :no-chord-p t)))
     ("float offset" (bad-make #'make-chord-symbol-anchor :position '(1 . 0.5)
                               :symbol (make-chord-symbol :no-chord-p t)))
     ("chord symbol as text" (bad-make #'make-chord-symbol-anchor :position '(1 . 0) :symbol "C7"))
     ("unknown spanner kind" (bad-make #'make-spanner :kind :tie :start "a" :end "b"))
     ("spanner without start" (bad-make #'make-spanner :kind :slur :end "b"))
     ("metadata value not a string" (bad-make #'make-score :metadata '(:title 3)))
     ("unknown metadata key" (bad-make #'make-score :metadata '(:key "C")))
     ("metadata key twice" (bad-make #'make-score :metadata '(:title "a" :title "b")))
     ("odd metadata plist" (bad-make #'make-score :metadata '(:title)))
     ("staff in the measure map" (bad-make #'make-score :measures (list (make-staff))))
     ("voice in place of a part" (bad-make #'make-score :parts (list (make-voice :measures '()))))
     ("spanner in the chord-symbol track"
      (bad-make #'make-score :chord-symbols (list (make-spanner :kind :slur :start "a" :end "b"))))
     ("negative id counter" (bad-make #'make-score :id-counter -1)))
  (ok (signals-type thunk 'type-error) label))

;;; Canonical form: elements --------------------------------------------------

(deftest-parametrize element-canonical-forms
    ((label element form)
     ("note with defaults left out"
      (make-note-event :id "x" :pitch (p "F#4") :duration 3/8 :accidental :auto
                       :articulations '(:staccato :accent) :breath-mark t
                       :lyrics (list (make-lyric :verse 2 :text "b")
                                     (make-lyric :text "a" :syllabic :begin :extender t))
                       :provenance (make-provenance :source :omr :page 2)
                       :confidence 1/2)
      '(:note :id "x" :pitch "F#4" :duration 3/8 :articulations (:accent :staccato)
        :breath-mark t
        :lyrics ((:lyric :text "a" :syllabic :begin :extender t) (:lyric :verse 2 :text "b"))
        :provenance (:source :omr :page 2) :confidence 1/2))
     ("note with every slot"
      (make-note-event :id "y" :pitch (p "Bbb3") :duration 1/12 :tuplet 3/2
                       :grace :appoggiatura :accidental :cautionary :tie "z"
                       :articulations '(:tenuto) :fermata :short :breath-mark t
                       :dynamic :sfz)
      '(:note :id "y" :pitch "Bbb3" :duration 1/12 :tuplet 3/2 :grace :appoggiatura
        :accidental :cautionary :tie "z" :articulations (:tenuto) :fermata :short
        :breath-mark t :dynamic :sfz))
     ("rest without an id"
      (make-rest-event :duration 1 :measure-rest-p t :hidden-p nil)
      '(:rest :duration 1 :measure-rest t))
     ("hidden rest with a fermata"
      (make-rest-event :id "r" :duration 1/2 :hidden-p t :fermata :long :dynamic :p)
      '(:rest :id "r" :duration 1/2 :hidden t :fermata :long :dynamic :p))
     ("chord"
      (make-chord-event :notes (list (make-chord-note :pitch (p "C4"))
                                     (make-chord-note :pitch (p "E4") :tie "t" :confidence 0.5))
                        :duration 1/2 :grace :acciaccatura)
      '(:chord :notes ((:chord-note :pitch "C4") (:chord-note :pitch "E4" :tie "t" :confidence 0.5))
        :duration 1/2 :grace :acciaccatura))
     ("lyric with defaults" (make-lyric :id "l" :verse 1 :text "la" :syllabic :single)
      '(:lyric :id "l" :text "la"))
     ("staff" (make-staff :id "s") '(:staff :id "s"))
     ("bass staff" (make-staff :clef :bass) '(:staff :clef :bass))
     ("voice"
      (make-voice :id "v" :name "Alto" :staff 2 :stem :down
                  :measures (list '() (list (make-rest-event :duration 1))))
      '(:voice :id "v" :name "Alto" :staff 2 :stem :down :measures (() ((:rest :duration 1)))))
     ("part"
      (make-part :name "X" :staves (list (make-staff)) :voices (list (make-voice :measures '())))
      '(:part :name "X" :staves ((:staff)) :voices ((:voice :measures ()))))
     ("measure"
      (make-measure-info :id "m" :time (parse-meter "6/8") :key (parse-key "e") :pickup-p t
                         :length 1/8 :barline :regular :volta '(2 1) :jump '(:fine)
                         :tempo (list (make-tempo-mark :offset 1/4 :text "rit.")
                                      (make-tempo-mark :tempo (make-tempo :bpm 60 :beat-unit 3/8))))
      '(:measure :id "m" :time "6/8" :key "E minor" :pickup t :length 1/8 :volta (1 2)
        :jump (:fine) :tempo ((:bpm 60 :beat-unit 3/8) (:offset 1/4 :text "rit."))))
     ("measure with repeats and labels"
      (make-measure-info :number "12a" :barline :double :repeat-start t :repeat-end 3
                         :rehearsal "B" :key (parse-key "Bb major")
                         :provenance (make-provenance :source :musicxml :backend "b"))
      '(:measure :number "12a" :key "Bb major" :barline :double :repeat-start t
        :repeat-end 3 :rehearsal "B" :provenance (:source :musicxml :backend "b")))
     ("N.C."
      (make-chord-symbol-anchor :position '(2 . 0) :symbol (make-chord-symbol :no-chord-p t))
      '(:chord-symbol :bar 2 :offset 0 :symbol (:no-chord-p t)))
     ("altered chord symbol"
      (make-chord-symbol-anchor :id "h" :position '(1 . 3/4)
                                :symbol (make-chord-symbol :root (pc "Eb") :quality :dominant-7
                                                           :extensions '(9) :alterations '((5 . -1))
                                                           :bass (pc "G") :text "Eb9b5/G"))
      '(:chord-symbol :id "h" :bar 1 :offset 3/4
        :symbol (:root "Eb" :quality :dominant-7 :extensions (9) :alterations ((5 . -1))
                 :bass "G" :text "Eb9b5/G")))
     ("spanner with provenance"
      (make-spanner :kind :crescendo :start "a" :end "b"
                    :provenance (make-provenance :source :transcription :time-range '(1 2))
                    :confidence 0)
      '(:spanner :kind :crescendo :start "a" :end "b"
        :provenance (:source :transcription :time-range (1 2)) :confidence 0)))
  (ok (equal form (element-to-sexp element)) label)
  (ok (equal form (element-to-sexp (sexp-to-element form))) label))

(deftest empty-score-form
  (ok (equal '(:score :id-counter 0 :measures () :parts ()) (score-to-sexp (make-score))))
  (ok (equal '(:score :metadata (:title "x") :id-counter 7 :measures () :parts ())
             (score-to-sexp (make-score :metadata '(:title "x") :id-counter 7)))))

;;; Reading -------------------------------------------------------------------

(deftest sexp-reading-is-lenient
  (ok (equal '(:note :id "x" :pitch "C4" :duration 1/4)
             (element-to-sexp (sexp-to-element '(:note :duration 1/4 :pitch "C4" :id "x"))))
      "keys in any order")
  (let ((l (sexp-to-element '(:lyric :text "la"))))
    (ok (typep l 'lyric))
    (ok (and (= 1 (lyric-verse l)) (eq :single (lyric-syllabic l)))))
  (let ((s (sexp-to-score '(:score :parts ((:part :staves ((:staff))
                                             :voices ((:voice :measures (())))))
                           :measures ((:measure :time "3/4" :key "F major"))))))
    (ok (= 1 (score-first-bar s)) "a first measure that isn't a pickup is bar 1")
    (ok (equal '("m-1" "p-2" "st-3" "v-4") (ids (score-elements s))) "missing ids are minted")))

(defun format-error-position (form &optional (reader #'sexp-to-score))
  "The POSITION of the SCORE-FORMAT-ERROR that reading FORM signals, or :NONE."
  (let ((c (signalled (lambda () (funcall reader form)))))
    (if (typep c 'score-format-error)
        (and (eq :sexp (score-format-error-format c))
             (typep c 'score-error)
             (score-format-error-position c))
        :none)))

(deftest-parametrize sexp-format-errors
    ((label reader form position)
     ("not a score" #'sexp-to-score '(:part :staves () :voices ()) '(:part :staves () :voices ()))
     ("not a list" #'sexp-to-score :score :score)
     ("unknown kind" #'sexp-to-score
      '(:score :parts ((:part :staves ((:stave)) :voices ((:voice :measures ())))))
      '(:stave))
     ("nested form of the wrong kind" #'sexp-to-score
      '(:score :parts ((:part :staves ((:voice :measures ())) :voices ((:voice :measures ())))))
      '(:voice :measures ()))
     ("an event that isn't a form" #'sexp-to-element '(:voice :measures ((5))) 5)
     ("unknown key" #'sexp-to-element '(:note :pitch "C4" :duration 1/4 :colour :red)
      '(:note :pitch "C4" :duration 1/4 :colour :red))
     ("key twice" #'sexp-to-element '(:note :pitch "C4" :pitch "D4" :duration 1/4)
      '(:note :pitch "C4" :pitch "D4" :duration 1/4))
     ("odd plist" #'sexp-to-element '(:note :pitch "C4" :duration) '(:note :pitch "C4" :duration))
     ("unknown score key" #'sexp-to-score '(:score :tracks ()) '(:score :tracks ()))
     ("unknown key in a tempo mark" #'sexp-to-element '(:measure :tempo ((:offset 0 :speed 3)))
      '(:offset 0 :speed 3))
     ("unknown provenance key" #'sexp-to-element '(:staff :provenance (:source :omr :when 3))
      '(:source :omr :when 3))
     ("score form read as an element" #'sexp-to-element '(:score :measures ()) '(:score :measures ())))
  (ok (equal position (format-error-position form reader)) label))

(deftest sexp-reading-passes-other-errors-through
  (ok (eq :type (handler-case (sexp-to-element '(:note :pitch "C4" :duration 0))
                  (score-format-error () :format)
                  (type-error () :type))))
  (ok (eq :pitch (handler-case (sexp-to-element '(:note :pitch "H4" :duration 1/4))
                   (score-format-error () :format)
                   (invalid-pitch () :pitch))))
  (ok (eq :meter (handler-case (sexp-to-element '(:measure :time "4/3"))
                   (score-format-error () :format)
                   (invalid-meter () :meter))))
  (ok (eq :key (handler-case (sexp-to-element '(:measure :key "H major"))
                 (score-format-error () :format)
                 (invalid-key () :key))))
  (let ((n (handler-bind ((invalid-pitch (lambda (c) (use-value (p "C4") c))))
             (sexp-to-element '(:note :pitch "H4" :duration 1/4)))))
    (ok (equalp (p "C4") (note-pitch n)) "music-theory's USE-VALUE restart is still there")))

;;; Model equality --------------------------------------------------------------

(deftest score-equality
  (let* ((form (fixture-form "sc0-pickup"))
         (a (sexp-to-score form))
         (b (sexp-to-score form)))
    (ok (score-equal a b))
    (ok (score-equal a (sexp-to-score (subst 99 26 form :test #'eql)))
        "the id counter doesn't count")
    (ok (not (score-equal a (sexp-to-score (subst "C5" "B4" form :test #'equal))))
        "a pitch does")
    (ok (not (score-equal a (sexp-to-score (subst "e-2r" "e-b" form :test #'equal))))
        "an id does")
    (ok (not (score-equal a (sexp-to-score (subst :short :normal form)))) "a fermata does")
    (ok (not (score-equal a (copy-score a :metadata '(:title "Amazing Grace")))) "metadata does")))

(deftest score-equality-counts-provenance
  (let* ((form (fixture-form "sc0-omr-result"))
         (a (sexp-to-score form)))
    (ok (not (score-equal a (sexp-to-score (subst 0.31 0.3 form :test #'eql)))))
    (ok (not (score-equal a (sexp-to-score (subst "other" "omr-example" form :test #'equal)))))
    (ok (not (score-equal a (sexp-to-score (subst :user :omr form)))))))
